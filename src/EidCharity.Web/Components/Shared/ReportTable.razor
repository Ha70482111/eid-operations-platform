@inject Ui Ui
<div class="table-wrap"><table>
    <thead><tr><th>@Ui.T("البند", "Group")</th><th>@Ui.T("العملة", "Currency")</th><th class="num">@Ui.T("العمليات", "Count")</th><th class="num">@Ui.T("المؤكد", "Confirmed")</th><th class="num">@Ui.T("قيد التحقق", "Pending")</th><th class="num">@Ui.T("المسترد", "Refunded")</th><th class="num">@Ui.T("الصافي", "Net")</th></tr></thead>
    <tbody>
        @foreach (var r in Rows)
        {
            <tr><td><strong>@Ui.N(r.KeyAr, r.KeyEn)</strong></td><td>@r.Currency</td><td class="num">@r.Count</td><td class="num"><Money Value="r.Confirmed" ShowCurrency="false" /></td><td class="num"><Money Value="r.Pending" ShowCurrency="false" /></td><td class="num"><Money Value="r.Refunded" ShowCurrency="false" /></td><td class="num"><strong><Money Value="r.Net" ShowCurrency="false" /></strong></td></tr>
        }
    </tbody>
    @if (Rows.Count > 0)
    {
        <tfoot><tr><td colspan="2">@Ui.T("الإجمالي", "Total")</td><td class="num">@Rows.Sum(r => r.Count)</td><td class="num"><Money Value="Rows.Sum(r => r.Confirmed)" ShowCurrency="false" /></td><td class="num"><Money Value="Rows.Sum(r => r.Pending)" ShowCurrency="false" /></td><td class="num"><Money Value="Rows.Sum(r => r.Refunded)" ShowCurrency="false" /></td><td class="num"><Money Value="Rows.Sum(r => r.Net)" ShowCurrency="false" /></td></tr></tfoot>
    }
</table></div>
@code { [Parameter] public List<ReportRow> Rows { get; set; } = []; }

<div class="page-heading">
    <div>
        @if (!string.IsNullOrEmpty(Eyebrow)) { <span class="eyebrow">@Eyebrow</span> }
        <h1 tabindex="-1">@Title</h1>
        @if (!string.IsNullOrEmpty(Subtitle)) { <p>@Subtitle</p> }
    </div>
    @if (Actions is not null) { <div class="heading-actions">@Actions</div> }
</div>
@code {
    [Parameter] public string? Eyebrow { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}

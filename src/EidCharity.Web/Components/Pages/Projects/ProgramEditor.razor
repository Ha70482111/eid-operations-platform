@inject Ui Ui
<Modal Open="Open" OpenChanged="OpenChanged" Title="@(Model.Id == 0 ? Ui.T("برنامج جديد", "New program") : Ui.T("تعديل البرنامج", "Edit program"))" Wide="true">
    <ChildContent>
        <div class="form-grid">
            <div class="field"><label class="req">@Ui.T("الاسم بالعربية", "Name (Arabic)")</label><input @bind="Model.NameAr" /></div>
            <div class="field"><label class="req">@Ui.T("الاسم بالإنجليزية", "Name (English)")</label><input @bind="Model.NameEn" dir="ltr" /></div>
            <div class="field"><label class="req">@Ui.T("المركز المسؤول", "Responsible center")</label>
                <select @bind="Model.CenterId">@foreach (var c in Centers) { <option value="@c.Id">@Ui.Name(c)</option> }</select></div>
            <div class="field"><label>@Ui.T("العملة", "Currency")</label><input @bind="Model.Currency" dir="ltr" /></div>
            <div class="field"><label>@Ui.T("الميزانية المعتمدة", "Approved budget")</label><input type="number" step="0.01" @bind="Model.ApprovedBudget" dir="ltr" /></div>
            <div class="field"><label>@Ui.T("احتياطي غير موزع", "Unallocated reserve")</label><input type="number" step="0.01" @bind="Model.UnallocatedReserve" dir="ltr" /><span class="hint">@Ui.T("مجموع توزيعات المشاريع + الاحتياطي ≤ الميزانية", "Project allocations + reserve ≤ budget")</span></div>
            <div class="field"><label>@Ui.T("الوصف بالعربية", "Description (Arabic)")</label><textarea @bind="Model.DescriptionAr"></textarea></div>
            <div class="field"><label>@Ui.T("الوصف بالإنجليزية", "Description (English)")</label><textarea @bind="Model.DescriptionEn" dir="ltr"></textarea></div>
        </div>
    </ChildContent>
    <Footer>
        <button class="secondary-btn" @onclick="() => OpenChanged.InvokeAsync(false)">@Ui.T("إلغاء", "Cancel")</button>
        <button class="primary-btn" disabled="@Busy" @onclick="OnSave"><Icon Name="save" />@Ui.T("حفظ", "Save")</button>
    </Footer>
</Modal>
@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public ProgramInput Model { get; set; } = new();
    [Parameter] public List<Center> Centers { get; set; } = [];
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public bool Busy { get; set; }
}

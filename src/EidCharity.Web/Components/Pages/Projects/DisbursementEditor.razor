@page "/projects/disbursements/new"
@page "/projects/disbursements/{Id:int}/edit"
@attribute [Authorize(Policy = Perm.DisbCreate)]
@inherits EidPage

<PageTitle>@T("طلب صرف", "Disbursement request")</PageTitle>
<div class="page">
    <PageHeader Eyebrow="P15" Title="@(Id is null ? T("طلب صرف جديد", "New disbursement request") : T("تعديل طلب الصرف", "Edit disbursement request"))" Subtitle="@T("يُربط كل صرف ببند ميزانية في المشروع. لا يُعتمد صرف من تحصيل قيد التحقق أو تعهد غير محصل.", "Each disbursement is tied to a project budget line. No spending from pending collections or uncollected pledges.")" />
    <PageState Loading="Loading" Error="@Error">
        <section class="form-card">
            <div class="form-grid">
                <div class="field"><label class="req">@T("المشروع", "Project")</label>
                    <select @bind="_in.ProjectId" @bind:after="ProjectChanged" disabled="@(Id is not null)"><option value="0">—</option>@foreach (var p in _projects) { <option value="@p.Id">@p.Code — @Ui.N(p.NameAr, p.NameEn)</option> }</select></div>
                <div class="field"><label class="req">@T("بند الميزانية", "Budget line")</label>
                    <select @bind="_in.BudgetLineId"><option value="0">—</option>@foreach (var l in _lines) { <option value="@l.Id">@l.Code — @Ui.Name(l) (@T("متبقٍ", "rem.") @Ui.Money(l.Amount - _usage.GetValueOrDefault(l.Id)))</option> }</select></div>
                @if (_fin is not null)
                {
                    <div class="full notice-box @(_fin.AvailableToSpend > 0 ? "ok" : "warn")"><Icon Name="wallet-cards" />@T($"المتاح للصرف من التمويل المؤكد: {Ui.Money(_fin.AvailableToSpend)} ر.ق — المتبقي من الميزانية: {Ui.Money(_fin.BudgetRemaining)}", $"Available from confirmed funding: QAR {Ui.Money(_fin.AvailableToSpend)} — budget remaining: {Ui.Money(_fin.BudgetRemaining)}")</div>
                }
                <div class="field full"><label class="req">@T("الغرض", "Purpose")</label><input @bind="_in.Purpose" /></div>
                <div class="field"><label class="req">@T("المستفيد من الدفع", "Payee")</label><input @bind="_in.PayeeName" /></div>
                <div class="field"><label>@T("بيانات المستفيد (حساب/IBAN)", "Payee details (account/IBAN)")</label><input @bind="_in.PayeeDetails" dir="ltr" /></div>
                <div class="field"><label class="req">@T("المبلغ", "Amount")</label><input type="number" step="0.01" @bind="_in.Amount" dir="ltr" /></div>
                <div class="field"><label>@T("طريقة الدفع", "Payment method")</label>
                    <select @bind="_in.PaymentMethod"><option value="BankTransfer">@T("تحويل بنكي", "Bank transfer")</option><option value="Cheque">@T("شيك", "Cheque")</option><option value="Cash">@T("نقدي", "Cash")</option></select></div>
                <div class="field"><label>@T("نوع المصروف", "Expense type")</label>
                    <select @bind="_in.ExpenseType"><option value="Operational">@T("تشغيلي", "Operational")</option><option value="Procurement">@T("مشتريات", "Procurement")</option><option value="Beneficiary">@T("مساعدات مباشرة", "Direct aid")</option><option value="Contractor">@T("مقاول", "Contractor")</option></select></div>
                <div class="field"><label>@T("تاريخ الاستحقاق", "Due date")</label><input type="date" @bind="_in.DueDate" /></div>
                <div class="field"><label>@T("مرجع الفاتورة / العرض", "Invoice / quotation ref.")</label><input @bind="_in.InvoiceReference" /></div>
                <label class="check"><input type="checkbox" @bind="_in.IsAdvance" />@T("سلفة (تُسوى لاحقًا)", "Advance (settled later)")</label>
            </div>
            <div class="form-actions">
                <a class="secondary-btn" href="/projects/disbursements">@T("إلغاء", "Cancel")</a>
                <button class="secondary-btn" disabled="@Busy" @onclick="() => Save(false)"><Icon Name="save" />@T("حفظ كمسودة", "Save draft")</button>
                <button class="primary-btn" disabled="@Busy" @onclick="() => Save(true)"><Icon Name="send" />@T("حفظ وإرسال للمراجعة", "Save & submit")</button>
            </div>
        </section>
    </PageState>
</div>
@code {
    [Parameter] public int? Id { get; set; }
    [SupplyParameterFromQuery(Name = "project")] public int? ProjectQuery { get; set; }
    private DisbursementInput _in = new();
    private List<ProjectRow> _projects = [];
    private List<BudgetLine> _lines = [];
    private Dictionary<int, decimal> _usage = new();
    private ProjectFinancials? _fin;
    private bool _loaded;

    protected override async Task LoadAsync()
    {
        if (_loaded) return;
        var page = await S<ProjectService>().ListProjectsAsync(null, ApprovalStatus.FinanciallyApproved, null, 1);
        _projects = page.Items.ToList();
        for (var i = 2; i <= Math.Ceiling(page.Total / 20.0); i++) _projects.AddRange((await S<ProjectService>().ListProjectsAsync(null, ApprovalStatus.FinanciallyApproved, null, i)).Items);
        if (Id is int id)
        {
            var d = await S<DisbursementService>().GetAsync(id);
            _in = new DisbursementInput { Id = d.Id, ProjectId = d.ProjectId, BudgetLineId = d.BudgetLineId, Purpose = d.Purpose, PayeeName = d.PayeeName, PayeeDetails = d.PayeeDetails, Amount = d.Amount, PaymentMethod = d.PaymentMethod, ExpenseType = d.ExpenseType, IsAdvance = d.IsAdvance, DueDate = d.DueDate, InvoiceReference = d.InvoiceReference };
        }
        else if (ProjectQuery is int pid) _in.ProjectId = pid;
        if (_in.ProjectId != 0) await LoadProject();
        _loaded = true;
    }

    private async Task LoadProject()
    {
        _lines = await S<BudgetService>().LinesAsync(_in.ProjectId);
        _usage = await S<FinancialsService>().BudgetLineUsageAsync(_in.ProjectId);
        _fin = await S<FinancialsService>().ForProjectAsync(_in.ProjectId);
    }
    private async Task ProjectChanged() { _in.BudgetLineId = 0; _lines = []; _fin = null; if (_in.ProjectId != 0) await LoadProject(); }

    private async Task Save(bool submit)
    {
        var id = 0;
        var ok = await Run(async () =>
        {
            id = await S<DisbursementService>().SaveDraftAsync(_in);
            if (submit) await S<DisbursementService>().SubmitAsync(id);
        }, submit ? "أُرسل الطلب للمراجعة" : "تم حفظ المسودة", submit ? "Submitted for review" : "Draft saved", reload: false);
        if (ok) Nav.NavigateTo($"/projects/disbursements/{id}");
    }
}

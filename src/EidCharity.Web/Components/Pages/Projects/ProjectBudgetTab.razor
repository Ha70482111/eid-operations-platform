@inherits EidPage
<div class="grid-2">
    <section class="data-card">
        <div class="card-head">
            <div><h2>@T("بنود الميزانية", "Budget lines")</h2><p>@T("المجموع لا يتجاوز تكلفة التنفيذ. بعد الاعتماد يكون التعديل بطلب نقل معتمد.", "Total stays within execution cost. After approval, changes go through an approved transfer.")</p></div>
            @if (CanEdit) { <button class="secondary-btn btn-sm" @onclick="NewLine"><Icon Name="plus" />@T("بند جديد", "New line")</button> }
        </div>
        <PageState Loading="Loading" Error="@Error" Empty="@(_lines.Count == 0)" EmptyAr="لا توجد بنود" EmptyEn="No lines">
            <div class="table-wrap"><table>
                <thead><tr><th>@T("البند", "Line")</th><th class="num">@T("المعتمد", "Budget")</th><th class="num">@T("المستخدم", "Used")</th><th class="num">@T("المتبقي", "Remaining")</th><th></th></tr></thead>
                <tbody>
                    @foreach (var l in _lines)
                    {
                        var used = _usage.GetValueOrDefault(l.Id);
                        <tr>
                            <td><strong>@Ui.Name(l)</strong><span dir="ltr">@l.Code · @l.Category</span></td>
                            <td class="num"><Money Value="l.Amount" ShowCurrency="false" /></td>
                            <td class="num"><Money Value="used" ShowCurrency="false" /></td>
                            <td class="num"><Money Value="l.Amount - used" ShowCurrency="false" /></td>
                            <td class="actions">@if (CanEdit && Project.ApprovalStatus != ApprovalStatus.FinanciallyApproved) { <button class="icon-btn sm" @onclick="() => EditLine(l)"><Icon Name="pencil-line" /></button> }</td>
                        </tr>
                    }
                </tbody>
                <tfoot><tr><td>@T("الإجمالي", "Total")</td><td class="num"><Money Value="_lines.Sum(l => l.Amount)" ShowCurrency="false" /></td><td class="num"><Money Value="_usage.Values.Sum()" ShowCurrency="false" /></td><td class="num"><Money Value="_lines.Sum(l => l.Amount) - _usage.Values.Sum()" ShowCurrency="false" /></td><td></td></tr></tfoot>
            </table></div>
        </PageState>
    </section>
    <section class="data-card">
        <div class="card-head">
            <div><h2>@T("طلبات نقل الميزانية", "Budget transfers")</h2><p>@T("للنقل بين البنود مسار اعتماد مستقل ولا يغير قيود المتبرع تلقائيًا.", "Transfers have their own approval and never change donor restrictions automatically.")</p></div>
            @if (CanEdit && _lines.Count > 0) { <button class="secondary-btn btn-sm" @onclick="NewAdj"><Icon Name="arrow-left-right" />@T("طلب نقل", "Request transfer")</button> }
        </div>
        @if (_adjs.Count == 0) { <div class="empty-hint">@T("لا توجد طلبات", "No requests")</div> }
        <div class="table-wrap"><table><tbody>
            @foreach (var a in _adjs)
            {
                <tr>
                    <td><strong>@LineName(a.FromLineId) → @LineName(a.ToLineId)</strong><span>@a.Reason</span></td>
                    <td class="num"><Money Value="a.Amount" ShowCurrency="false" /></td>
                    <td><StatusPill Css="@(a.Status == AdjustmentStatus.Approved ? "success" : a.Status == AdjustmentStatus.Rejected ? "danger" : "warning")">@(a.Status switch { AdjustmentStatus.Approved => T("معتمد", "Approved"), AdjustmentStatus.Rejected => T("مرفوض", "Rejected"), _ => T("بانتظار الاعتماد", "Awaiting approval") })</StatusPill></td>
                    <td class="actions">@if (a.Status == AdjustmentStatus.Submitted && Can(Perm.BudgetApproveAdjustment)) {
                        <button class="danger-text" @onclick="() => Decide(a.Id, false)">@T("رفض", "Reject")</button>
                        <button class="primary-btn btn-sm" @onclick="() => Decide(a.Id, true)">@T("اعتماد", "Approve")</button> }</td>
                </tr>
            }
        </tbody></table></div>
    </section>
</div>
<Modal @bind-Open="_lineOpen" Title="@T("بند ميزانية", "Budget line")">
    <ChildContent>
        <div class="form-grid">
            <div class="field"><label class="req">@T("الاسم بالعربية", "Name (Arabic)")</label><input @bind="_line.NameAr" /></div>
            <div class="field"><label>@T("الاسم بالإنجليزية", "Name (English)")</label><input @bind="_line.NameEn" dir="ltr" /></div>
            <div class="field"><label>@T("التصنيف", "Category")</label><input @bind="_line.Category" /></div>
            <div class="field"><label class="req">@T("المبلغ", "Amount")</label><input type="number" step="0.01" @bind="_line.Amount" dir="ltr" /></div>
        </div>
    </ChildContent>
    <Footer><button class="primary-btn" disabled="@Busy" @onclick="SaveLine">@T("حفظ", "Save")</button></Footer>
</Modal>
<Modal @bind-Open="_adjOpen" Title="@T("طلب نقل بين البنود", "Budget transfer request")">
    <ChildContent>
        <div class="form-grid">
            <div class="field"><label>@T("من بند", "From line")</label><select @bind="_adj.FromLineId"><option value="">@T("— احتياطي —", "— reserve —")</option>@foreach (var l in _lines) { <option value="@l.Id">@l.Code — @Ui.Name(l)</option> }</select></div>
            <div class="field"><label>@T("إلى بند", "To line")</label><select @bind="_adj.ToLineId"><option value="">—</option>@foreach (var l in _lines) { <option value="@l.Id">@l.Code — @Ui.Name(l)</option> }</select></div>
            <div class="field"><label class="req">@T("المبلغ", "Amount")</label><input type="number" step="0.01" @bind="_adj.Amount" dir="ltr" /></div>
            <div class="field full"><label class="req">@T("السبب", "Reason")</label><textarea @bind="_adj.Reason"></textarea></div>
        </div>
    </ChildContent>
    <Footer><button class="primary-btn" disabled="@Busy" @onclick="SaveAdj">@T("إرسال", "Submit")</button></Footer>
</Modal>
@code {
    [Parameter] public Project Project { get; set; } = default!;
    [Parameter] public ProjectFinancials Financials { get; set; } = default!;
    [Parameter] public EventCallback OnChanged { get; set; }
    private List<BudgetLine> _lines = [];
    private List<BudgetAdjustment> _adjs = [];
    private Dictionary<int, decimal> _usage = new();
    private bool _lineOpen, _adjOpen;
    private BudgetLine _line = new();
    private BudgetAdjustment _adj = new();
    private bool CanEdit => Can(Perm.BudgetManage) && !Project.IsClosed;

    protected override async Task LoadAsync()
    {
        _lines = await S<BudgetService>().LinesAsync(Project.Id);
        _adjs = await S<BudgetService>().AdjustmentsAsync(Project.Id);
        _usage = await S<FinancialsService>().BudgetLineUsageAsync(Project.Id);
    }
    private string LineName(int? id) => id is null ? T("الاحتياطي", "Reserve") : _lines.FirstOrDefault(l => l.Id == id)?.Code ?? "?";
    private void NewLine() { _line = new BudgetLine { ProjectId = Project.Id }; _lineOpen = true; }
    private void EditLine(BudgetLine l) { _line = new BudgetLine { Id = l.Id, ProjectId = l.ProjectId, NameAr = l.NameAr, NameEn = l.NameEn, Category = l.Category, Amount = l.Amount }; _lineOpen = true; }
    private void NewAdj() { _adj = new BudgetAdjustment { ProjectId = Project.Id }; _adjOpen = true; }
    private async Task SaveLine() { if (await Run(() => S<BudgetService>().SaveLineAsync(_line), "تم حفظ البند", "Line saved")) { _lineOpen = false; await OnChanged.InvokeAsync(); } }
    private async Task SaveAdj() { if (await Run(() => S<BudgetService>().RequestAdjustmentAsync(_adj), "أُرسل طلب النقل", "Transfer requested")) _adjOpen = false; }
    private async Task Decide(int id, bool approve) { if (await Run(() => S<BudgetService>().DecideAdjustmentAsync(id, approve, null, S<FinancialsService>()), approve ? "اعتُمد النقل" : "رُفض الطلب", approve ? "Transfer approved" : "Rejected")) await OnChanged.InvokeAsync(); }
}

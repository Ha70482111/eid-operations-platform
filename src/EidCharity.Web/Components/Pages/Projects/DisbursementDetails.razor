@page "/projects/disbursements/{Id:int}"
@attribute [Authorize(Policy = Perm.BudgetView + "," + Perm.DisbReview + "," + Perm.DisbFinanceCheck + "," + Perm.DisbApprove + "," + Perm.DisbExecute)]
@inherits EidPage

<PageTitle>@T("طلب صرف", "Disbursement") @_d?.Number</PageTitle>
<div class="page">
    <PageState Loading="Loading" Error="@Error">
        @if (_d is not null && _f is not null)
        {
            <PageHeader Eyebrow="@($"P15 · P16 · {_d.Number}")" Title="@_d.Purpose" Subtitle="@($"{_d.Project?.Code} — {(_d.Project is null ? "" : Ui.Name(_d.Project))}")">
                <Actions>
                    <StatusPill Tone="StatusText.Of(_d.Status)" />
                    @if (_d.Status is DisbursementStatus.Draft or DisbursementStatus.ReturnedForEdit && Can(Perm.DisbCreate))
                    {
                        <a class="secondary-btn" href="/projects/disbursements/@_d.Id/edit"><Icon Name="pencil-line" />@T("تعديل", "Edit")</a>
                        <button class="primary-btn" disabled="@Busy" @onclick="Submit"><Icon Name="send" />@T("إرسال للمراجعة", "Submit")</button>
                    }
                </Actions>
            </PageHeader>
            <section class="data-card mb">
                <div class="path">
                    @{ var steps = new[] { (T("المسودة", "Draft"), true), (T("مراجعة المختص", "Specialist review"), _d.SpecialistReviewed), (T("التحقق المالي", "Finance check"), _d.FinanceChecked), (T("الاعتماد والحجز", "Approval & reserve"), _d.ApprovedById is not null), (T("التنفيذ", "Execution"), _d.ExecutedAmount > 0) }; var current = steps.ToList().FindIndex(s => !s.Item2); }
                    @for (var i = 0; i < steps.Length; i++)
                    {
                        if (i > 0) { <span class="p-sep"></span> }
                        <span class="p-step @(steps[i].Item2 ? "done" : i == current ? "current" : "")"><i>@(i + 1)</i>@steps[i].Item1</span>
                    }
                </div>
            </section>
            <section class="metric-strip">
                <Metric Label="@T("المبلغ المطلوب", "Requested")" Value="@Ui.Money(_d.Amount)" IconName="banknote" />
                <Metric Label="@T("المحجوز", "Reserved")" Value="@Ui.Money(_d.ReservedAmount)" IconName="lock" />
                <Metric Label="@T("المنفذ", "Executed")" Value="@Ui.Money(_d.ExecutedAmount)" Note="@T($"المحرر {Ui.Money(_d.ReleasedAmount)}", $"Released {Ui.Money(_d.ReleasedAmount)}")" IconName="circle-check" />
                <Metric Label="@T("المتاح للصرف في المشروع", "Project available to spend")" Value="@Ui.Money(_f.AvailableToSpend)" Note="@T($"المتبقي من الميزانية {Ui.Money(_f.BudgetRemaining)}", $"Budget remaining {Ui.Money(_f.BudgetRemaining)}")" IconName="wallet-cards" Warn="@(_f.AvailableToSpend < _d.Amount - _d.ReservedAmount - _d.ExecutedAmount)" />
            </section>
            @if (_similar.Count > 0)
            {
                <div class="notice-box warn"><Icon Name="triangle-alert" />@T("تنبيه: طلبات مشابهة (نفس المستفيد والمبلغ) — تحقق من عدم ازدواج الصرف:", "Warning: similar requests (same payee and amount) — check for duplicate payment:") @string.Join("، ", _similar.Select(s => s.Number))</div>
            }
            <div class="grid-2">
                <section class="data-card">
                    <div class="card-head"><div><h2>@T("بيانات الطلب", "Request data")</h2></div></div>
                    <div class="kv">
                        <div><span>@T("بند الميزانية", "Budget line")</span><strong>@_d.BudgetLine?.Code — @(_d.BudgetLine is null ? "" : Ui.Name(_d.BudgetLine))</strong></div>
                        <div><span>@T("المستفيد", "Payee")</span><strong>@_d.PayeeName</strong></div>
                        <div><span>@T("بيانات الدفع", "Payee details")</span><strong dir="ltr">@_d.PayeeDetails</strong></div>
                        <div><span>@T("طريقة الدفع", "Method")</span><strong>@_d.PaymentMethod</strong></div>
                        <div><span>@T("نوع المصروف", "Expense type")</span><strong>@_d.ExpenseType @(_d.IsAdvance ? T("· سلفة", "· advance") : "")</strong></div>
                        <div><span>@T("الاستحقاق", "Due")</span><strong dir="ltr">@Ui.Date(_d.DueDate)</strong></div>
                        <div><span>@T("الفاتورة", "Invoice")</span><strong>@(_d.InvoiceReference ?? "—")</strong></div>
                    </div>
                </section>
                <section class="data-card">
                    <div class="card-head"><div><h2>@T("الإجراءات", "Actions")</h2><p>@T("لا يعتمد مقدم الطلب طلبه، والاعتماد ضمن حدود مصفوفة الصلاحيات", "Requesters can't approve their own; approval within the authority matrix")</p></div></div>
                    <div class="card-pad stack">
                        <div class="field"><label>@T("ملاحظة القرار", "Decision note")</label><textarea @bind="_note"></textarea></div>
                        <div class="row">
                            @if (_d.Status == DisbursementStatus.Submitted && Can(Perm.DisbReview))
                            {
                                <button class="primary-btn" disabled="@Busy" @onclick="@(() => Specialist("approve"))">@T("اعتماد المراجعة", "Approve review")</button>
                                <button class="secondary-btn" disabled="@Busy" @onclick="@(() => Specialist("return"))">@T("إعادة للتعديل", "Return")</button>
                                <button class="danger-text" disabled="@Busy" @onclick="@(() => Specialist("reject"))">@T("رفض", "Reject")</button>
                            }
                            @if (_d.Status == DisbursementStatus.UnderReview && _d.SpecialistReviewed && !_d.FinanceChecked && Can(Perm.DisbFinanceCheck))
                            {
                                <button class="primary-btn" disabled="@Busy" @onclick="@(() => Finance("approve"))">@T("التمويل متاح", "Funding available")</button>
                                <button class="secondary-btn" disabled="@Busy" @onclick="@(() => Finance("return"))">@T("إعادة", "Return")</button>
                            }
                            @if (_d.Status == DisbursementStatus.UnderReview && _d.FinanceChecked && Can(Perm.DisbApprove))
                            {
                                <button class="primary-btn" disabled="@Busy" @onclick="Approve"><Icon Name="badge-check" />@T("اعتماد وحجز المبلغ", "Approve & reserve")</button>
                            }
                            @if (_d.Status is DisbursementStatus.ApprovedReserved or DisbursementStatus.PartiallyExecuted && Can(Perm.DisbExecute))
                            {
                                <button class="primary-btn" @onclick="OpenExecute"><Icon Name="banknote" />@T("تسجيل دفعة", "Record payment")</button>
                            }
                            @if (_d.Status == DisbursementStatus.PartiallyExecuted && Can(Perm.DisbCancel))
                            {
                                <button class="secondary-btn" disabled="@Busy" @onclick="Release">@T("تحرير المتبقي المحجوز", "Release remaining reserve")</button>
                            }
                            @if (_d.Status is not (DisbursementStatus.FullyExecuted or DisbursementStatus.Cancelled or DisbursementStatus.Rejected) && _d.ExecutedAmount == 0 && CanAny(Perm.DisbCancel, Perm.DisbCreate))
                            {
                                <button class="danger-text" disabled="@Busy" @onclick="Cancel"><Icon Name="ban" />@T("إلغاء الطلب", "Cancel request")</button>
                            }
                        </div>
                    </div>
                </section>
            </div>
            <div class="grid-2 mt">
                <section class="data-card">
                    <div class="card-head"><div><h2>@T("الدفعات المنفذة", "Payments")</h2></div></div>
                    @if (_d.Payments.Count == 0) { <div class="empty-hint">@T("لا توجد دفعات", "No payments")</div> }
                    <div class="table-wrap"><table><tbody>
                        @foreach (var p in _d.Payments) { <tr><td><strong dir="ltr">@p.Reference</strong><span>@p.DocumentReference</span></td><td dir="ltr">@Ui.Date(p.PaidOn)</td><td class="num"><Money Value="p.Amount" /></td></tr> }
                    </tbody></table></div>
                </section>
                <section class="data-card">
                    <div class="card-head"><div><h2>@T("سجل القرارات", "Decision log")</h2></div></div>
                    <ul class="timeline">
                        @foreach (var a in _d.Actions.OrderByDescending(a => a.Id))
                        {
                            <li><strong>@a.Step — @a.Decision</strong><small>@a.ByUserName · @Ui.DateTimeStr(a.CreatedAt)</small>@if (!string.IsNullOrEmpty(a.Note)) { <p>@a.Note</p> }</li>
                        }
                    </ul>
                </section>
            </div>
            <div class="mt"><AttachmentsPanel OwnerType="DisbursementRequest" OwnerId="_d.Id" CanUpload="@(CanAny(Perm.DisbCreate, Perm.DisbExecute))" /></div>
        }
    </PageState>
</div>
<Modal @bind-Open="_execOpen" Title="@T("تسجيل دفعة منفذة", "Record executed payment")">
    <ChildContent>
        <div class="form-grid">
            <div class="field"><label class="req">@T("المبلغ", "Amount")</label><input type="number" step="0.01" @bind="_payAmount" dir="ltr" /><span class="hint">@T("المحجوز المتبقي", "Remaining reserve"): @Ui.Money(_d?.ReservedAmount ?? 0)</span></div>
            <div class="field"><label class="req">@T("تاريخ الدفع", "Paid on")</label><input type="date" @bind="_paidOn" /></div>
            <div class="field"><label class="req">@T("مرجع الدفع", "Payment reference")</label><input @bind="_payRef" dir="ltr" /></div>
            <div class="field"><label>@T("مرجع المستند", "Document reference")</label><input @bind="_payDoc" /></div>
        </div>
    </ChildContent>
    <Footer><button class="primary-btn" disabled="@Busy" @onclick="Execute">@T("تسجيل", "Record")</button></Footer>
</Modal>
@code {
    [Parameter] public int Id { get; set; }
    private DisbursementRequest? _d;
    private ProjectFinancials? _f;
    private List<DisbursementRequest> _similar = [];
    private string _note = "";
    private bool _execOpen;
    private decimal _payAmount; private DateOnly _paidOn = DateOnly.FromDateTime(QatarTime.Now); private string _payRef = ""; private string? _payDoc;

    protected override async Task LoadAsync()
    {
        _d = await S<DisbursementService>().GetAsync(Id);
        _f = await S<FinancialsService>().ForProjectAsync(_d.ProjectId);
        _similar = (await S<DisbursementService>().SimilarAsync(_d)).Where(s => s.Id != _d.Id).ToList();
    }
    private Task Submit() => Run(() => S<DisbursementService>().SubmitAsync(Id), "أُرسل للمراجعة", "Submitted");
    private Task Specialist(string decision) => Run(() => S<DisbursementService>().SpecialistReviewAsync(Id, decision, _note), "تم تسجيل القرار", "Decision recorded");
    private Task Finance(string decision) => Run(() => S<DisbursementService>().FinanceCheckAsync(Id, decision, _note), "تم تسجيل القرار", "Decision recorded");
    private Task Approve() => Run(() => S<DisbursementService>().ApproveAsync(Id, _note), "اعتُمد الطلب وحُجز المبلغ", "Approved and reserved");
    private Task Release() => Run(() => S<DisbursementService>().ReleaseRemainderAsync(Id, string.IsNullOrWhiteSpace(_note) ? "تحرير المتبقي" : _note), "تم تحرير المتبقي", "Remainder released");
    private Task Cancel() => Run(() => S<DisbursementService>().CancelAsync(Id, string.IsNullOrWhiteSpace(_note) ? "إلغاء" : _note), "أُلغي الطلب", "Request cancelled");
    private void OpenExecute() { _payAmount = _d!.ReservedAmount; _payRef = ""; _payDoc = null; _execOpen = true; }
    private async Task Execute() { if (await Run(() => S<DisbursementService>().ExecuteAsync(Id, _payAmount, _paidOn, _payRef, _payDoc), "تم تسجيل الدفعة", "Payment recorded")) _execOpen = false; }
}
